{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "true",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5[1m]",
    "ANTHROPIC_MODEL": "opusplan"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git pull:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",
      "Bash(icalPal:*)",
      "Bash(date:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(gh pr comment:*)",
      "Bash(tmux rename-window:*)",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__notion__notion-query-data-sources",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Gmail__gmail_search_messages",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__aws-terraform-mcp-server__SearchAwsProviderDocs",
      "mcp__aws-knowledge-mcp-server__aws___search_documentation"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(./secrets/**)",
      "Read(**/.aws/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/**)",
      "Read(**/.ssh/id_*)",
      "Read(**/.gnupg/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/.ssh/id_*)",
      "Read(**/node_modules/**)",
      "Read(**/.terraform/**)",
      "Read(**/__pycache__/**)",
      "Read(**/venv/**)",
      "Read(**/.venv/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/*.log)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh repo create:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE_PATH=$(jq -r '.tool_input.file_path // .tool_input.path // \"\"'); [ -n \"$FILE_PATH\" ] || exit 0; REAL=$(readlink -f \"$FILE_PATH\" 2>/dev/null) || REAL=\"$(readlink -f \"$(dirname \"$FILE_PATH\")\" 2>/dev/null)/$(basename \"$FILE_PATH\")\"; case \"$REAL\" in *chroju/dotfiles/dotfiles/*) [ \"$REAL\" = \"$FILE_PATH\" ] || { echo \"ERROR: $FILE_PATH is a symlink into the dotfiles repository. Edit $REAL directly instead.\" >&2; exit 2; } ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE_PATH=$(jq -r '.tool_input.file_path') && [ -n \"$(tail -c1 \"$FILE_PATH\")\" ] && echo >> \"$FILE_PATH\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs -I {} sed -i '' 's/[[:space:]]*$//' '{}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/tmux-stop.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/rate_limits_cache.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/herdr-notify.sh stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/tmux-working.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/tmux-notify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/herdr-notify.sh notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/herdr-approve.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/tmux-window-name-check.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/bun $HOME/dev/src/github.com/chroju/obsidian/scripts/session_anchor.ts",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline-wrapper.sh",
    "padding": 0
  },
  "enabledPlugins": {},
  "alwaysThinkingEnabled": false,
  "plansDirectory": "./.local/claude/plans",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "classifyAllShell": true
  }
}
