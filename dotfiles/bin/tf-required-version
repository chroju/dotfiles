#!/usr/bin/env bash
# Resolve a Terraform version from required_version, for mise config:
#   terraform = "{{ exec(command='tf-required-version ' ~ cwd) | trim }}"
# mise evaluates templates in the config file's directory, so the target
# directory arrives as an argument.
#
# Deliberately approximate: it reads the first constraint and maps it to a
# version or prefix mise understands. Upper bounds (">= 1.5, < 1.9") are not
# honored — use "~>" when a ceiling matters.
dir="${1:-$PWD}"

while [[ "$dir" != "/" ]]; do
  c=$(cat "$dir"/*.tf 2>/dev/null \
      | sed -nE 's/^[[:space:]]*required_version[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' \
      | head -n1 | cut -d, -f1 | tr -d ' ')
  if [[ -n "$c" ]]; then
    case "$c" in
      =*|[0-9]*) echo "${c#=}" ;;               # = 1.9.5 → 1.9.5
      "~>"*)     v="${c#~>}"; echo "${v%.*}" ;; # ~> 1.9.0 → 1.9 (mise resolves the prefix)
      *)         echo latest ;;                 # >= and friends: lower bound only
    esac
    exit 0
  fi
  dir=$(dirname "$dir")
done

echo latest
