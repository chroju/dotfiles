#!/bin/bash
# List tmux windows with Claude Code status and switch with fzf.
# The window list itself comes from tmux-agents.

if [ "$1" = "--list" ]; then
  exec tmux-agents --fzf
fi

[ -z "$TMUX" ] && { echo "Error: must be run inside tmux" >&2; exit 1; }
command -v fzf &>/dev/null || { echo "Error: fzf not found" >&2; exit 1; }

selected=$(fzf \
  --ansi \
  --with-nth=3.. \
  --delimiter=$'\t' \
  --preview='tmux capture-pane -p -e -t {1}:{2} 2>&1 | grep -v "^$" | tail -40' \
  --preview-window='right,55%,border-left,follow' \
  --header='tmux windows  [Enter: switch / Ctrl-X: kill / Ctrl-N: new / Ctrl-R: reload / Esc: cancel]' \
  --prompt='window> ' \
  --bind="start:reload:tmux-agents --fzf" \
  --bind="ctrl-r:reload:tmux-agents --fzf" \
  --bind="ctrl-x:execute-silent(tmux kill-window -t {1}:{2})+reload(tmux-agents --fzf)" \
  --bind="ctrl-n:execute(tmux-dev)+abort" \
  --bind="load:reload-sync(sleep 1; tmux-agents --fzf)+rebind(load)" < /dev/null)

[ -z "$selected" ] && exit 0

target_session=$(printf '%s' "$selected" | cut -f1)
target_window=$(printf '%s' "$selected" | cut -f2)

tmux switch-client -t "$target_session"
tmux select-window -t "${target_session}:${target_window}"
